# Force LF line endings for shell scripts (required for Docker)
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Auto detect text files and normalize to LF
* text=auto eol=lf

# Force LF for specific file types
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
